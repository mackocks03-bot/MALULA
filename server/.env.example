# PalmPesa (Tanzania automatic deposits & activation)
PALMPESA_API_KEY=your_api_key_from_palmpesa_dashboard
PALMPESA_USER_ID=your_palmpesa_user_id
PALMPESA_VENDOR=TILL61103867

# Optional override (default: https://palmpesa.drmlelwa.co.tz/api)
# PALMPESA_API_URL=https://palmpesa.drmlelwa.co.tz/api

# PalmPesa Webhook Secret — set in your PalmPesa dashboard callback settings.
# If set, the server validates all webhook requests against this value.
# PALMPESA_WEBHOOK_SECRET=your_webhook_secret

# Admin Secret — required for POST /api/activation/admin/approve/:paymentId
# If set, admin panel must send this in x-admin-secret header.
# ADMIN_SECRET=your_admin_secret

# Firebase Web API key (same as client firebase-config) — verifies user sessions
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_DATABASE_URL=https://newhope-chatapp-default-rtdb.asia-southeast1.firebasedatabase.app

# Firebase service account JSON (one line) — required for server-side RTDB writes
# (activation queue, deposit queue, admin approval)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

PORT=5000
NODE_ENV=development
