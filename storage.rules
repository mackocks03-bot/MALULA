rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow users to upload to their own activation_proofs folder
    match /activation_proofs/{userId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    
    // Default fallback
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
