rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core function to check if user is an admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // loginIndex: needed for username-availability checks at registration (unauthenticated)
    match /loginIndex/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /phoneIndex/{phone} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // settings: read-only for everyone (exchange rates, fee config used at registration)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Any authenticated user may READ user profiles (needed for referral tree queries)
      allow read: if request.auth != null;
      // Only owner or admin can fully write their own document
      // Owner CANNOT change the 'role' field — only admin can change role
      allow write: if request.auth != null && request.auth.uid == userId
        && (resource == null || request.resource.data.role == resource.data.role);
      allow write: if isAdmin();
      // Any authenticated user may increment referralCount or update referrals arrays
      // (this fires during new-user registration, where the new user writes to the referrer's doc)
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['referrals', 'referralCount']);
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /userTasks/{userTaskId} {
      allow read: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if request.auth != null && (request.resource.data.uid == request.auth.uid || resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    match /sellerProducts/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.sellerUid == request.auth.uid || isAdmin());
    }
    
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /notifications/{notifId} {
      allow read, update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      // Client needs to create withdrawals
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      // Client creates transactions occasionally
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /activationPayments/{paymentId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      // Client queues payments
      allow create, update: if request.auth != null && (request.resource.data.uid == request.auth.uid || resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    match /shopDeposits/{depositId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }
    
    match /palmpesaPending/{pendingId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }
    
    // Orders: buyers create, sellers update status
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null && request.resource.data.buyerUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.sellerUid == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Business KYC Verification
    // Users submit their own doc (docId == uid). Owner can update for location; admin can approve/reject.
    match /businessVerification/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // ── Chat Collections ──────────────────────────────────────────────────────
    // Global chat messages: any authenticated user can read and send
    match /chatMessages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Daily message count tracker (docId = uid_date)
    match /chatCount/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid
        || request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Chat bonus claim flags (docId = uid_date)
    match /chatBonus/{docId} {
      allow read, write: if request.auth != null && (
        request.resource.data.uid == request.auth.uid ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
    }

    // Online presence (docId = uid)
    match /online/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Admin Broadcast Messages — any authenticated user can read; only admin can write/delete
    match /adminMessages/{msgId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Default fallback (block writes unless admin)
    match /{document=**} {
      allow read: if request.auth != null && isAdmin();
      allow write: if request.auth != null && isAdmin();
    }
  }
}
